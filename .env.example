# Frontend-Konfiguration für die Benachrichtigungen (Bauabschnitt 8).
# Kopiere diese Datei nach `.env` und trage deine Werte ein.
#
# Ohne diese Werte laufen alle anderen Funktionen normal; nur die Erinnerungen
# in den Einstellungen bleiben dann deaktiviert (mit ruhigem Hinweis).

# Öffentlicher VAPID-Schlüssel (base64url), aus:  npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=

# Basis-URL des Cloudflare Workers, z. B. https://gebet-benachrichtigung.<konto>.workers.dev
VITE_WORKER_URL=

# Firebase (Anmeldung und Geräteabgleich, Bauabschnitt 9). Aus der Firebase-
# Konsole: Projekteinstellungen → Deine Apps → Web-App → SDK-Konfiguration.
# Ohne diese Werte bleibt die Anmeldung ausgeblendet, die App läuft rein lokal.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
